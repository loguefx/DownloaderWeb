{
  "name": "webvideodownloader",
  "version": "0.1.0",
  "description": "Standalone Electron app with its own browser that detects and bulk-downloads videos as .mp4 (HLS + direct), like Video DownloadHelper.",
  "main": "src/main/main.js",
  "author": "WebVideoDownloader <dev@webvideodownloader.local>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/postinstall.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.webvideodownloader.app",
    "productName": "WebVideoDownloader",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "category": "AudioVideo",
      "maintainer": "WebVideoDownloader <dev@webvideodownloader.local>",
      "synopsis": "Browser-based video detector and bulk downloader",
      "description": "Standalone Electron app with its own browser that detects and bulk-downloads videos as .mp4 (HLS + direct)."
    }
  }
}
