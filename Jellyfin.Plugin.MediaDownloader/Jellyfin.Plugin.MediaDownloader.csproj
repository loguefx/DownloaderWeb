<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Media Downloader - Jellyfin plugin (Jellyfin_Integration/Build plan, Part 2 + Part 4).

    Multi-targets the current stable Jellyfin lines so the same source builds
    a plugin for each server generation (install the build that matches your
    server):
      net8.0  -> Jellyfin 10.10   (Jellyfin.Controller 10.10.*)
      net9.0  -> Jellyfin 10.11   (Jellyfin.Controller 10.11.*)
      net10.0 -> Jellyfin 12.0    (Jellyfin.Controller 12.0.0)
    The 12.x API is a superset-compatible line; the code compiles for all
    three without #ifdefs.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.MediaDownloader</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.10.*" />
    <PackageReference Include="Jellyfin.Model" Version="10.10.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.*" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Web\settings.html" />
    <None Remove="Web\overview.html" />
    <EmbeddedResource Include="Web\settings.html" />
    <EmbeddedResource Include="Web\overview.html" />
  </ItemGroup>

</Project>
