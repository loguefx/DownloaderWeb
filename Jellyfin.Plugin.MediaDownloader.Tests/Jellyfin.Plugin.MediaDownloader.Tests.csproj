<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration harness (build plan Part 4): drives the plugin's outbox
    worker against the REAL engine HTTP API (started by
    scripts/test-plugin-outbox.js under plain Node). Verifies the
    exactly-once delivery states: offline -> waiting-to-send, online -> sent,
    engine 4xx -> rejected, and re-delivery of an accepted jobId is ignored.

    Multi-targets the same Jellyfin lines as the plugin so the ITG can be
    run against each build (10.10 / 10.11 / 12.0).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.MediaDownloader\Jellyfin.Plugin.MediaDownloader.csproj" />
  </ItemGroup>

  <!--
    The plugin excludes the Jellyfin runtime assets (the real server supplies
    them). This harness is the stand-in server, so it references the same
    packages directly with full assets. Direct refs also win over the
    transitive (excluded) ones.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.10.*" />
    <PackageReference Include="Jellyfin.Model" Version="10.10.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.*" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

</Project>
